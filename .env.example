# ==============================================
# reconstruircolombia — variables de entorno
# ==============================================
# Copia este archivo a .env y completa los valores reales.
# .env NUNCA se versiona (ver .gitignore).
# ==============================================

NODE_ENV=development

# Secreto de NextAuth v5 para firmar JWT/cookies de sesion.
# Genera uno con: openssl rand -hex 24
AUTH_SECRET=reemplaza_con_openssl_rand_hex_24

# Conexion a Postgres. En dev local, ver docker-compose.dev.yml
# (puerto 5433, atado a 127.0.0.1).
DATABASE_URL="postgresql://reconstruir_user:cambia_esta_contrasena@127.0.0.1:5433/reconstruir_dev_db?schema=public"

# Compose lee esta variable para el Postgres del contenedor.
# Debe coincidir con la contrasena de la DATABASE_URL de arriba.
DB_PASSWORD=cambia_esta_contrasena

# MailerSend — correo transaccional (verificacion de email, canal de
# contacto). Token con alcance "Email", generado en app.mailersend.com.
MAILERSEND_API_KEY=mlsn.reemplaza_con_tu_token

# URL base del sitio, para armar enlaces absolutos en los correos.
# En dev: http://localhost:3000. En prod: el dominio real.
APP_URL=http://localhost:3000

# Servicio interno de embeddings para el modulo RAG (ver docker-compose.dev.yml
# y embeddings/app.py). Local, sin API externa.
EMBEDDINGS_URL=http://127.0.0.1:8007

# Groq (generacion del asistente RAG, API compatible con OpenAI). Genera una
# API key en console.groq.com/keys. Fase 2: la ruta /asistente no esta
# enlazada aun desde el sitio, ver lib/rag/prompt-sistema.md.
GROQ_API_KEY=gsk_reemplaza_con_tu_api_key
