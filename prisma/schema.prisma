// =============================================================
// reconstruircolombia — Schema Prisma v1 (dominio ampliado)
// =============================================================
// Modelo anclado en marcos humanitarios reales:
// - Categorias alineadas a clusteres ONU/Esfera, en lenguaje de la persona.
// - Verificacion por niveles de confianza (suma, nunca requisito para publicar).
// - Validacion por pares con salvaguardas anti-fraude.
// - Organizaciones de sociedad civil como entidad propia (Via B).
//
// Principio: "el esquema anticipa el poder, la v1 implementa lo esencial".
// Se modela todo el dominio; algunas piezas (subida de documentos, enlace RUD
// activo) quedan modeladas pero se implementan despues.
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// -------------------- GEOGRAFIA (seed DIVIPOLA) --------------------

model Departamento {
  codigo   String @id @db.VarChar(2)
  nombre   String
  latitud  Float?
  longitud Float?

  municipios Municipio[]

  @@map("departamentos")
}

model Municipio {
  codigo        String  @id @db.VarChar(5)
  nombre        String
  slug          String
  tipoMunicipio String? @map("tipo_municipio")
  latitud       Float?
  longitud      Float?

  departamentoCodigo String       @map("departamento_codigo") @db.VarChar(2)
  departamento       Departamento @relation(fields: [departamentoCodigo], references: [codigo])

  usuarios       User[]
  necesidades    Necesidad[]
  ofrecimientos  Ofrecimiento[]
  organizaciones Organizacion[]

  @@index([departamentoCodigo])
  @@index([slug])
  @@map("municipios")
}

// -------------------- ORGANIZACIONES (sociedad civil) --------------------
// Instituciones educativas, JAC, fundaciones, colectivos. Entidad propia:
// varios usuarios pueden pertenecer a una. Dos niveles de verificacion.

enum TipoOrganizacion {
  INSTITUCION_EDUCATIVA
  JAC // Junta de Accion Comunal
  FUNDACION
  COLECTIVO
  ENTIDAD_OFICIAL
  OTRA
}

enum EstadoOrganizacion {
  REGISTRADA // datos basicos; actua de inmediato pero sin verificar
  VERIFICADA // documento validado (NIT/RUT/personeria/acta) por un moderador
}

model Organizacion {
  id          String             @id @default(cuid())
  nombre      String
  tipo        TipoOrganizacion
  estado      EstadoOrganizacion @default(REGISTRADA)
  descripcion String?

  // Contacto de la organizacion (no es dato de damnificado; es institucional).
  contactoEmail    String? @map("contacto_email")
  contactoTelefono String? @map("contacto_telefono")

  // Municipio sede (de donde es la organizacion). Operacion multi-municipio -> v2.
  municipioCodigo String    @map("municipio_codigo") @db.VarChar(5)
  municipio       Municipio @relation(fields: [municipioCodigo], references: [codigo])

  // Documento de verificacion: MODELADO pero la subida segura de archivos se
  // implementa despues (requiere almacenamiento privado, fuera del repo).
  // Aqui solo se guarda la referencia/URL al documento cuando exista.
  documentoUrl  String?   @map("documento_url")
  verificadaPor String?   @map("verificada_por") // id del moderador
  verificadaEn  DateTime? @map("verificada_en")

  // Miembros y actividad.
  miembros                User[]
  necesidadesReportadas   Necesidad[]    @relation("NecesidadOrganizacion")
  ofrecimientosReportados Ofrecimiento[] @relation("OfrecimientoOrganizacion")
  validaciones            Validacion[]   @relation("ValidacionOrganizacion")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([municipioCodigo])
  @@index([estado])
  @@map("organizaciones")
}

// -------------------- USUARIOS Y AUTENTICACION --------------------

enum Rol {
  DAMNIFICADO
  DONANTE
  MODERADOR
  ADMIN
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String?
  nombre   String?
  telefono String?
  rol      Rol     @default(DAMNIFICADO)
  // Desactivacion en vez de borrado: preserva trazabilidad anti-fraude.
  activo   Boolean @default(true)

  // Verificacion de correo: SUMA confianza (ej. badge visible), NUNCA es
  // requisito para usar la plataforma. Null = sin verificar; se puede
  // iniciar sesion, registrar necesidades y todo lo demas igual.
  emailVerificado DateTime? @map("email_verificado")

  municipioCodigo String?    @map("municipio_codigo") @db.VarChar(5)
  municipio       Municipio? @relation(fields: [municipioCodigo], references: [codigo])

  // Un usuario puede pertenecer a UNA organizacion (opcional).
  organizacionId String?       @map("organizacion_id")
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])

  necesidades         Necesidad[]         @relation("NecesidadAutor")
  ofrecimientos       Ofrecimiento[]      @relation("OfrecimientoAutor")
  validaciones        Validacion[]        @relation("ValidacionValidador")
  solicitudesEnviadas SolicitudContacto[] @relation("SolicitudSolicitante")
  tokensVerificacion  TokenVerificacion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([municipioCodigo])
  @@index([organizacionId])
  @@map("usuarios")
}

// Token de un solo uso para verificar el correo. Se borra al consumirse
// (exito) o al expirar (chequeo en la Server Action). Si se borra el
// usuario, sus tokens pendientes se borran con el (cascade).
model TokenVerificacion {
  id     String   @id @default(cuid())
  token  String   @unique
  expira DateTime

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("tokens_verificacion")
}

// -------------------- NECESIDAD (nucleo del MVP) --------------------

// Categorias alineadas a clusteres ONU/Esfera, en lenguaje de la persona.
enum CategoriaNecesidad {
  AGUA_SANEAMIENTO // WASH
  ALIMENTOS // Seguridad alimentaria
  ALOJAMIENTO // Refugio / shelter
  SALUD // Salud
  HIGIENE // WASH / kits de higiene
  ROPA_ABRIGO // necesidad local post-sismo
  PROTECCION // menores no acompanados, violencia, personas vulnerables
  EDUCACION // ninos sin escuela
  RESCATE // rescate / remocion de escombros (fase aguda)
  OTRO
}

enum Urgencia {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

// Estado gestionado por moderacion (distinto del nivel de confianza, que se
// deriva de las validaciones). Hibrido: estado explicito + validaciones contadas.
enum EstadoNecesidad {
  PENDIENTE // recien creada, aun sin revision de moderador
  EN_PROCESO // alguien esta atendiendola
  RESUELTA
  RECHAZADA // moderador la marco invalida
}

// Quien reporta: la propia persona afectada, o alguien en su nombre.
enum TipoReporte {
  PROPIA
  EN_NOMBRE_DE
}

model Necesidad {
  id          String             @id @default(cuid())
  titulo      String
  descripcion String
  categoria   CategoriaNecesidad
  urgencia    Urgencia           @default(MEDIA)
  estado      EstadoNecesidad    @default(PENDIENTE)
  numPersonas Int                @default(1) @map("num_personas")

  // Poblacion vulnerable: booleanos para priorizar sin exponer detalle.
  hayMenores              Boolean @default(false) @map("hay_menores")
  hayAdultosMayores       Boolean @default(false) @map("hay_adultos_mayores")
  hayPersonasDiscapacidad Boolean @default(false) @map("hay_personas_discapacidad")
  hayGestantes            Boolean @default(false) @map("hay_gestantes")
  hayEnfermosCronicos     Boolean @default(false) @map("hay_enfermos_cronicos")

  // Quien reporta.
  tipoReporte TipoReporte @default(PROPIA) @map("tipo_reporte")

  // CONTACTO SENSIBLE — nunca en listados publicos ni mapa abierto.
  contactoNombre   String? @map("contacto_nombre")
  contactoTelefono String? @map("contacto_telefono")
  contactoEmail    String? @map("contacto_email")

  // ENLACE OFICIAL SENSIBLE — radicado del RUD/RUNDA. Mismo tratamiento que
  // el contacto: nunca expuesto en publico. Cotejo con RUD activo -> despues.
  radicadoRud String? @map("radicado_rud")

  // Geo-etiqueta obligatoria.
  municipioCodigo String    @map("municipio_codigo") @db.VarChar(5)
  municipio       Municipio @relation(fields: [municipioCodigo], references: [codigo])

  // Autor: usuario que registro (siempre existe en v1, requiere login).
  autorId String @map("autor_id")
  autor   User   @relation("NecesidadAutor", fields: [autorId], references: [id])

  // Si la reporta una organizacion en nombre de la comunidad (nivel 1b).
  organizacionId String?       @map("organizacion_id")
  organizacion   Organizacion? @relation("NecesidadOrganizacion", fields: [organizacionId], references: [id])

  // Validaciones que respaldan esta necesidad (nivel de confianza se deriva
  // de contar y ponderar estas).
  validaciones Validacion[]

  // Solicitudes de contacto mediado (Modelo B): un donante pide que se le
  // habilite el canal de contacto con el autor. Ver SolicitudContacto.
  solicitudes SolicitudContacto[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([municipioCodigo])
  @@index([categoria])
  @@index([estado])
  @@index([urgencia])
  @@index([autorId])
  @@index([organizacionId])
  @@map("necesidades")
}

// -------------------- OFRECIMIENTO (espejo de Necesidad) --------------------
// Alguien (persona u organizacion) ofrece ayuda material o de servicio.
// Comparte categoria con Necesidad (mismo lenguaje de clusteres ONU/Esfera:
// un ofrecimiento se categoriza por el tipo de necesidad que cubre) y el
// mismo tratamiento de contacto sensible y canal mediado (SolicitudContacto,
// ver mas abajo, ahora bidireccional) y validacion por pares (Validacion).

enum TipoAyuda {
  MATERIAL // bienes: alimentos, ropa, kits, materiales de construccion...
  SERVICIO // labor: transporte, atencion medica, mano de obra, asesoria...
}

enum EstadoOfrecimiento {
  ACTIVO // disponible, se puede solicitar contacto
  PAUSADO // temporalmente no disponible (ej. capacidad agotada)
  CERRADO // el ofrecimiento ya no esta en pie
}

model Ofrecimiento {
  id          String             @id @default(cuid())
  tipoAyuda   TipoAyuda          @map("tipo_ayuda")
  // Reutiliza CategoriaNecesidad: el ofrecimiento se clasifica por la
  // necesidad que busca cubrir, mismo enum que Necesidad.categoria.
  categoria   CategoriaNecesidad
  descripcion String
  // Texto libre: "20 kits de aseo", "3 dias/semana de transporte", etc.
  // No se modela como numero porque la capacidad de ayuda humanitaria rara
  // vez es un conteo simple (ver Necesidad.numPersonas, que si lo es).
  capacidad   String?
  estado      EstadoOfrecimiento @default(ACTIVO)

  // CONTACTO SENSIBLE — mismo tratamiento que Necesidad: nunca en listados
  // publicos ni mapa abierto. Select explicito que lo excluye en toda
  // consulta publica.
  contactoNombre   String? @map("contacto_nombre")
  contactoTelefono String? @map("contacto_telefono")
  contactoEmail    String? @map("contacto_email")

  // Geo-etiqueta obligatoria.
  municipioCodigo String    @map("municipio_codigo") @db.VarChar(5)
  municipio       Municipio @relation(fields: [municipioCodigo], references: [codigo])

  // Autor: usuario que registro (siempre existe en v1, requiere login).
  autorId String @map("autor_id")
  autor   User   @relation("OfrecimientoAutor", fields: [autorId], references: [id])

  // Si lo ofrece una organizacion (persona vinculada a una organizacion
  // registrada reporta en su nombre). Opcional: tambien puede ofrecer una
  // persona sola.
  organizacionId String?       @map("organizacion_id")
  organizacion   Organizacion? @relation("OfrecimientoOrganizacion", fields: [organizacionId], references: [id])

  // Validaciones que respaldan este ofrecimiento (mismo anti-fraude que Necesidad).
  validaciones Validacion[]

  // Solicitudes de contacto mediado: quien necesita esta ayuda pide que se
  // le habilite el canal con quien la ofrece. Ver SolicitudContacto.
  solicitudes SolicitudContacto[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([municipioCodigo])
  @@index([categoria])
  @@index([tipoAyuda])
  @@index([estado])
  @@index([autorId])
  @@index([organizacionId])
  @@map("ofrecimientos")
}

// -------------------- VALIDACION (anti-fraude, validacion por pares) --------------------
// Cada validacion suma confianza visible a una Necesidad U Ofrecimiento.
// NUNCA es requisito para publicar. Salvaguardas:
//  - Identidad detras: validadorId siempre requerido (no anonimo).
//  - No autovalidacion: se valida en la Server Action que validadorId != autor.
//  - Una por usuario por necesidad/ofrecimiento: constraints unicos.
//  - Peso por confianza del validador: se calcula en logica (cuentas nuevas
//    o sin historial pesan menos); el tipo distingue comunitaria vs institucional.
//
// Bidireccional (Opcion A): necesidadId y ofrecimientoId son AMBOS opcionales,
// pero un CHECK constraint en la base de datos (ver migracion SQL, Prisma no
// tiene atributo nativo para esto) garantiza que exactamente uno de los dos
// este presente en cada fila. Prisma no "ve" ese constraint (no esta en el
// lenguaje del schema) asi que no lo toca en migraciones futuras: vive en el
// SQL de la migracion, no aqui.

enum TipoValidacion {
  COMUNITARIA // un vecino/par identificado confirma "me consta que es real"
  INSTITUCIONAL // respaldada por una organizacion
}

model Validacion {
  id   String         @id @default(cuid())
  tipo TipoValidacion @default(COMUNITARIA)
  // Comentario opcional del validador (por que le consta).
  nota String?

  // Quien valida (identidad obligatoria, nunca anonimo).
  validadorId String @map("validador_id")
  validador   User   @relation("ValidacionValidador", fields: [validadorId], references: [id])

  // Exactamente uno de los dos (CHECK en la migracion SQL, ver arriba).
  // Si se borra la necesidad/ofrecimiento, sus validaciones se borran.
  necesidadId String?    @map("necesidad_id")
  necesidad   Necesidad? @relation(fields: [necesidadId], references: [id], onDelete: Cascade)

  ofrecimientoId String?       @map("ofrecimiento_id")
  ofrecimiento   Ofrecimiento? @relation(fields: [ofrecimientoId], references: [id], onDelete: Cascade)

  // Si la validacion la hace en representacion de una organizacion (nivel 1b).
  organizacionId String?       @map("organizacion_id")
  organizacion   Organizacion? @relation("ValidacionOrganizacion", fields: [organizacionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  // Un usuario solo puede validar una vez cada necesidad, y una vez cada
  // ofrecimiento (anti-inflado). Con la columna opuesta en NULL, Postgres
  // trata cada NULL como distinto, asi que estos dos constraints no
  // colisionan entre si.
  @@unique([validadorId, necesidadId])
  @@unique([validadorId, ofrecimientoId])
  @@index([necesidadId])
  @@index([ofrecimientoId])
  @@index([validadorId])
  @@map("validaciones")
}

// -------------------- SOLICITUD DE CONTACTO (canal controlado, Modelo B) --------------------
// El contacto real (telefono/correo de ambas partes) nunca se expone en la
// plataforma por si solo. Alguien que quiere el canal (un donante pidiendo
// ayudar con una necesidad, o un damnificado pidiendo la ayuda que alguien
// ofrece) pide habilitarlo; la otra parte (autor de la necesidad u
// ofrecimiento) decide si lo acepta. Solo entonces, y solo a las dos partes
// involucradas, se revela el contacto — siempre dentro de la plataforma,
// tras login, nunca en el correo de aviso.
//
// Bidireccional (Opcion A): mismo patron que Validacion arriba. necesidadId
// y ofrecimientoId son ambos opcionales; un CHECK constraint en la
// migracion SQL garantiza que exactamente uno este presente.

enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

model SolicitudContacto {
  id      String          @id @default(cuid())
  estado  EstadoSolicitud @default(PENDIENTE)
  mensaje String?

  // Quien pide el contacto (identidad obligatoria, nunca anonimo).
  solicitanteId String @map("solicitante_id")
  solicitante   User   @relation("SolicitudSolicitante", fields: [solicitanteId], references: [id])

  // Exactamente uno de los dos (CHECK en la migracion SQL, ver arriba).
  // Si se borra la necesidad/ofrecimiento, sus solicitudes se borran.
  necesidadId String?    @map("necesidad_id")
  necesidad   Necesidad? @relation(fields: [necesidadId], references: [id], onDelete: Cascade)

  ofrecimientoId String?       @map("ofrecimiento_id")
  ofrecimiento   Ofrecimiento? @relation(fields: [ofrecimientoId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now()) @map("created_at")
  respondidaEn DateTime? @map("respondida_en")

  // Una solicitud activa por solicitante por necesidad, y una por
  // solicitante por ofrecimiento (anti-spam: no puede insistir creando
  // solicitudes repetidas). Con la columna opuesta en NULL, estos dos
  // constraints no colisionan entre si (mismo razonamiento que Validacion).
  @@unique([solicitanteId, necesidadId])
  @@unique([solicitanteId, ofrecimientoId])
  @@index([necesidadId])
  @@index([ofrecimientoId])
  @@index([solicitanteId])
  @@map("solicitudes_contacto")
}

// -------------------- RAG: FRAGMENTOS DE MANUALES (Fase 1) --------------------
// Tuberia de recuperacion para el futuro modulo de IA (Fase 2, Groq) que
// orientara la rehabilitacion de viviendas de bahareque y tapia pisada. Esta
// fase SOLO indexa los manuales tecnicos de la AIS; no hay asistente todavia.
//
// El campo `embedding` es tipo `vector` (pgvector), que Prisma Client no
// soporta de forma nativa: se mapea como Unsupported y toda lectura/escritura
// de ese campo se hace con SQL crudo ($queryRaw/$executeRaw), ver lib/rag/.
// 384 dimensiones = intfloat/multilingual-e5-small (ver embeddings/app.py).
model FragmentoManual {
  id String @id @default(cuid())

  // De que manual viene el fragmento (identificador corto, no el titulo
  // completo) y opcionalmente seccion/pagina, para poder citar la fuente.
  manual       String
  tituloManual String  @map("titulo_manual")
  seccion      String?
  pagina       Int?

  texto     String
  embedding Unsupported("vector(384)")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([manual])
  @@map("fragmentos_manual")
}
